# Local development only. Real deploy inputs live in cdk.json, never here.
# Nothing in this file is read by the CDK app.

AWS_PROFILE=claude-sandbox
# Amazon Connect does not exist in us-east-2. Do not "fix" this to match jarvis.
AWS_REGION=us-west-2

# Overrides for running a handler locally against a seeded bucket.
MOSS_INDEX_BUCKET=
MOSS_INDEX_MANIFEST_KEY=manifests/current.json
MOSS_LATENCY_BUDGET_MS=120
MOSS_MIN_SCORE=0.25
