{
  "name": "moss-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon Connect <-> Moss integration: sub-10ms semantic retrieval for contact-center voice agents",
  "bin": {
    "moss-connect": "bin/moss-connect.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy --all",
    "lint": "tsc --noEmit",
    "bench": "ts-node scripts/benchmark.ts",
    "preflight": "bash scripts/preflight.sh",
    "precdk:deploy": "bash scripts/preflight.sh",
    "precdk:diff": "bash scripts/preflight.sh",
    "audit:accounts": "bash scripts/audit-accounts.sh",
    "seed-index": "ts-node scripts/seed-index.ts"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "aws-cdk": "^2.160.0",
    "esbuild": "^0.28.2",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1136.0",
    "@aws-sdk/client-cloudwatch": "^3.665.0",
    "@aws-sdk/client-s3": "^3.665.0",
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.3.0"
  }
}
